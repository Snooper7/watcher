# =====================================================================
# Whatcher — Telegram price monitoring bot
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
# =====================================================================

# ------- Required -------

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram group/chat ID for price reports (negative number for groups)
GROUP_CHAT_ID=

# ------- Optional -------

# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///data/whatcher.db

# Log level: DEBUG (dev) | INFO (prod) | WARNING | ERROR
LOG_LEVEL=INFO

# Price check schedule — comma-separated times in H:MM format (server local time)
CHECK_TIMES=7:00,13:00,20:00

# Path to Chrome/Chromium binary for the Ozon scraper (nodriver).
# Leave empty to auto-detect: Playwright Chromium cache → system PATH.
# Example: /opt/whatcher/.cache/ms-playwright/chromium-1161/chrome-linux/chrome
CHROME_EXECUTABLE_PATH=
